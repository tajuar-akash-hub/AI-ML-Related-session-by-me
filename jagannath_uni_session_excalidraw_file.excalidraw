      "type": "text",
      "x": -9876.542676766987,
      "y": -436.8565850876503,
      "width": 406.79999999999995,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "CYeiLaObHGdWLUNNNXYpm",
      "roundness": null,
      "seed": 428438871,
      "version": 12,
      "versionNonce": 942938615,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Next, study how a Transformer represents context and how a GPU speeds up tensor work.",
      "originalText": "Next, study how a Transformer represents context and how a GPU speeds up tensor work.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8l",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "I0xQvGA-BMEVDJqYbzikm",
      "type": "text",
      "x": -9401.942676766988,
      "y": -818.7965850876499,
      "width": 219.865456,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#36526e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 629060215,
      "version": 12,
      "versionNonce": 673965305,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "06 OF 07   /   TRANSFORMER ARCHITECTURE",
      "originalText": "06 OF 07   /   TRANSFORMER ARCHITECTURE",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8m",
