      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Use word counts or TF-IDF for text. One-hot encode\nchannel. Extract weekday from the timestamp.",
      "originalText": "Use word counts or TF-IDF for text. One-hot encode\nchannel. Extract weekday from the timestamp.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
