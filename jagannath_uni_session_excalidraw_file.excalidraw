      "link": null,
      "locked": false,
      "text": "Become an ML engineer",
      "originalText": "Become an ML engineer",
      "fontSize": 15.819999999999999,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
