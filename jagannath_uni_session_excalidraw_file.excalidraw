      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "NEE7epqCyhM9fQMqtH8LX",
      "type": "text",
      "x": -9401.942676766988,
      "y": -799.5865850876498,
      "width": 197.89464,
      "height": 19.775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 906972055,
      "version": 12,
      "versionNonce": 749454103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Inside a Transformer",
      "originalText": "Inside a Transformer",
      "fontSize": 15.819999999999999,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8n",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "kDkzqivgPztZY_3gYjZgQ",
      "type": "text",
      "x": -9401.942676766988,
      "y": -770.7715850876502,
      "width": 406.79999999999995,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 1466941623,
      "version": 12,
      "versionNonce": 389471705,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Follow a decoder-only language model as it generates a draft reply, one token at a time.",
      "originalText": "Follow a decoder-only language model as it generates a draft reply, one token at a time.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8o",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "iiFAk6jKDz28iRDPTCgF_",
      "type": "text",
      "x": -9245.437676766987,
      "y": -728.3965850876502,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 457478615,
      "version": 12,
      "versionNonce": 1116817463,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Split the input into tokens. Map token IDs to vectors.\nPosition information tells the model their order.",
      "originalText": "Split the input into tokens. Map token IDs to vectors.\nPosition information tells the model their order.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8p",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "wzTsL26wS4M8fp4WtDmAX",
      "type": "text",
      "x": -9245.437676766987,
      "y": -678.1115850876504,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 1789017847,
      "version": 12,
      "versionNonce": 1613740729,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Each query scores earlier keys and its own key.\nThe weights mix values across multiple heads.",
      "originalText": "Each query scores earlier keys and its own key.\nThe weights mix values across multiple heads.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8q",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "m-NJyfZ03hqiHSJPpRlVt",
      "type": "text",
      "x": -9245.437676766987,
      "y": -627.8265850876505,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 403523607,
      "version": 12,
      "versionNonce": 1204365655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Each position passes through a small neural network.\nResidual paths and normalization connect the layers.",
      "originalText": "Each position passes through a small neural network.\nResidual paths and normalization connect the layers.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8r",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ZCWX0iwDZhWkL0Ty-px9K",
      "type": "text",
      "x": -9245.437676766987,
      "y": -577.5415850876498,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 830090551,
      "version": 12,
      "versionNonce": 1404697497,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Stack attention and feed-forward blocks. Later\nrepresentations combine more contextual information.",
      "originalText": "Stack attention and feed-forward blocks. Later\nrepresentations combine more contextual information.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8s",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "z8olfYqVlJtv9mH3zNEHr",
      "type": "text",
      "x": -9245.437676766987,
      "y": -527.2565850876499,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 307064407,
      "version": 12,
      "versionNonce": 1504175735,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Project to vocabulary scores. Softmax gives\nprobabilities. Pick a token, append it and repeat.",
      "originalText": "Project to vocabulary scores. Softmax gives\nprobabilities. Pick a token, append it and repeat.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8t",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "BaQ_8WmY8A5k2WsDA-FH9",
      "type": "text",
      "x": -9401.942676766988,
      "y": -460.58658508764984,
      "width": 406.61739199999994,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 895191927,
      "version": 12,
      "versionNonce": 1644765305,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Another design  ·  The original Transformer has an encoder and a decoder.",
      "originalText": "Another design  ·  The original Transformer has an encoder and a decoder.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8u",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "8YJMJ5z3OjD07np24Scqk",
      "type": "text",
      "x": -9401.942676766988,
      "y": -437.4215850876499,
      "width": 406.79999999999995,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "audXlIJkIw_K_6PgQGqLt",
      "roundness": null,
      "seed": 1189676183,
      "version": 12,
      "versionNonce": 1995571095,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "The encoder reads the input. The decoder uses cross-attention to that input.",
      "originalText": "The encoder reads the input. The decoder uses cross-attention to that input.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8v",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "WHuKOBW_O8mmASdCvC-zZ",
      "type": "text",
      "x": -8927.342676766988,
      "y": -818.7965850876499,
      "width": 159.445712,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#36526e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 1990875575,
      "version": 12,
      "versionNonce": 685812057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "07 OF 07   /   GPU COMPUTING",
      "originalText": "07 OF 07   /   GPU COMPUTING",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8w",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "tMj7dIgFv-hlQrrVVORAL",
      "type": "text",
      "x": -8927.342676766988,
      "y": -799.5865850876498,
      "width": 149.83347999999998,
      "height": 19.775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 163842775,
      "version": 12,
      "versionNonce": 1373369527,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Where CUDA fits",
      "originalText": "Where CUDA fits",
      "fontSize": 15.819999999999999,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8x",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "spbSxG6Aau4eaKIXViQtQ",
      "type": "text",
      "x": -8927.342676766988,
      "y": -770.7715850876502,
      "width": 406.79999999999995,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 751474679,
      "version": 12,
      "versionNonce": 1100224057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "CUDA runs parallel calculations on NVIDIA GPUs. Tensor operations are one example.",
      "originalText": "CUDA runs parallel calculations on NVIDIA GPUs. Tensor operations are one example.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8y",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "cvod3Byobkswo-2HuEqzM",
      "type": "text",
      "x": -8770.837676766987,
      "y": -728.3965850876502,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 96633111,
      "version": 12,
      "versionNonce": 1644840407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Tokenize a batch of tickets on the host. Assemble\nnumeric arrays called tensors.",
      "originalText": "Tokenize a batch of tickets on the host. Assemble\nnumeric arrays called tensors.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8z",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Jra03cVyTdmKHQa7wkMRY",
      "type": "text",
      "x": -8770.837676766987,
      "y": -678.1115850876504,
      "width": 236.34356799999995,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 102778423,
      "version": 12,
      "versionNonce": 1325852441,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Move the model and inputs to GPU memory.\nIn PyTorch, select a CUDA device for both.",
      "originalText": "Move the model and inputs to GPU memory.\nIn PyTorch, select a CUDA device for both.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b90",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "A1ggVKdC8zv_bqtgtB1QY",
      "type": "text",
      "x": -8770.837676766987,
      "y": -627.8265850876505,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 2093508439,
      "version": 12,
      "versionNonce": 915501815,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "The framework calls GPU functions through CUDA.\nMany threads compute pieces of a matrix operation.",
      "originalText": "The framework calls GPU functions through CUDA.\nMany threads compute pieces of a matrix operation.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b91",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "BQi-MnqoKB3I07-jrbP2w",
      "type": "text",
      "x": -8770.837676766987,
      "y": -577.5415850876498,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "AyXUO46ibLNWs-4UVR4_L",
      "roundness": null,
      "seed": 1745839223,
      "version": 12,
      "versionNonce": 1269603321,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Training also computes gradients to update weights.\nInference uses the fitted weights to predict.",
