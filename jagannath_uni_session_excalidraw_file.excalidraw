      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "A cloud service runs the API on a remote computer. The prediction can work while the developer’s laptop is off.",
      "originalText": "A cloud service runs the API on a remote computer. The prediction can work while the developer’s laptop is off.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
