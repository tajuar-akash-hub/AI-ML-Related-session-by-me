      "type": "text",
      "x": 7866.557771370376,
      "y": -725.1764630173375,
      "width": 1185,
      "height": 25,
      "angle": 0,
      "strokeColor": "#36526e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
