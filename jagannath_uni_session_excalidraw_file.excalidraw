      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Practice shapes, matrix multiplication and activations.\nBuild a tiny network in PyTorch.",
      "originalText": "Practice shapes, matrix multiplication and activations.\nBuild a tiny network in PyTorch.",
      "fontSize": 9.04,
      "fontFamily": 6,
