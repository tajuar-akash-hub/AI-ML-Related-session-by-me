      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Demo in a deployed service  ·  Open its /docs page, choose POST /predict, then Try it out and Execute.",
      "originalText": "Demo in a deployed service  ·  Open its /docs page, choose POST /predict, then Try it out and Execute.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
