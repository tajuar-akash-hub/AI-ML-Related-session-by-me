      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Ticket text, channel and creation time are available\nwhen a customer first asks for help.",
      "originalText": "Ticket text, channel and creation time are available\nwhen a customer first asks for help.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
