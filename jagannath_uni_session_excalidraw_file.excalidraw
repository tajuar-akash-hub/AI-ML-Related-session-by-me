      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "A feature is an input the model can use when it makes a prediction.",
      "originalText": "A feature is an input the model can use when it makes a prediction.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
