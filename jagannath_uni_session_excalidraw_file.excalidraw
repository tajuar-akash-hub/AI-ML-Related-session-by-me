      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "If you enjoy studying routing errors, try the ML path. If you enjoy designing a useful reply assistant, try the AI path.",
      "originalText": "If you enjoy studying routing errors, try the ML path. If you enjoy designing a useful reply assistant, try the AI path.",
