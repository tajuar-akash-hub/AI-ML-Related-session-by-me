      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "A neural network learns useful representations by adjusting weights to reduce a loss.",
      "originalText": "A neural network learns useful representations by adjusting weights to reduce a loss.",
