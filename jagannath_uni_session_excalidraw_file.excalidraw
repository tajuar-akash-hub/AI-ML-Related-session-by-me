      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "rMa0MRyR4YDCSz2PYbT-w",
      "type": "text",
      "x": -11774.942676766987,
      "y": -770.7715850876502,
      "width": 406.79999999999995,
      "height": 11.299999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PGfKuGW3B5mQzxy01dHR2",
      "roundness": null,
      "seed": 703896695,
      "version": 12,
      "versionNonce": 926924793,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Learn to make a prediction, measure its errors and serve it in an application.",
      "originalText": "Learn to make a prediction, measure its errors and serve it in an application.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b80",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "-Is4uSGKrScNRCWMIaRML",
      "type": "text",
      "x": -11618.437676766987,
      "y": -728.3965850876502,
      "width": 207.66651916503906,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PGfKuGW3B5mQzxy01dHR2",
      "roundness": null,
      "seed": 1211626903,
      "version": 13,
      "versionNonce": 764876823,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Learn Python, Git and SQL. Read a CSV, clean text,\nand join each ticket to its final support queue.",
      "originalText": "Learn Python, Git and SQL. Read a CSV, clean text,\nand join each ticket to its final support queue.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b81",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "5Vwe5eBU6VTz4Mz5dkRTV",
      "type": "text",
      "x": -11618.437676766987,
      "y": -678.1115850876504,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PGfKuGW3B5mQzxy01dHR2",
      "roundness": null,
      "seed": 854796983,
      "version": 12,
      "versionNonce": 1830246617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Use vectors for features, probability for uncertainty,\nand averages and distributions to describe data.",
      "originalText": "Use vectors for features, probability for uncertainty,\nand averages and distributions to describe data.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b82",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "gzPDaCVT-i-g5sG1U61OO",
      "type": "text",
      "x": -11618.437676766987,
      "y": -627.8265850876505,
      "width": 192.08157348632812,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PGfKuGW3B5mQzxy01dHR2",
      "roundness": null,
      "seed": 1187691479,
      "version": 13,
      "versionNonce": 357170487,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Try a keyword rule, then fit a linear classifier.\nKeep newer tickets aside to test generalization.",
      "originalText": "Try a keyword rule, then fit a linear classifier.\nKeep newer tickets aside to test generalization.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b83",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "8sUSAPoOgGdJj2HOsGYdy",
      "type": "text",
      "x": -11618.437676766987,
      "y": -577.5415850876498,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PGfKuGW3B5mQzxy01dHR2",
      "roundness": null,
      "seed": 1473456375,
      "version": 12,
      "versionNonce": 977851833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Build a confusion matrix. Calculate billing recall.\nRead missed tickets and write down why they failed.",
      "originalText": "Build a confusion matrix. Calculate billing recall.\nRead missed tickets and write down why they failed.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b84",
      "created": 1795105606538,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "9IO9GlFxju28khJJVUlvS",
      "type": "text",
      "x": -11618.437676766987,
      "y": -527.2565850876499,
      "width": 250.295,
      "height": 22.599999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.13,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PGfKuGW3B5mQzxy01dHR2",
      "roundness": null,
      "seed": 1133572631,
      "version": 12,
      "versionNonce": 195247703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795105606552,
      "link": null,
      "locked": false,
      "text": "Serve one model with FastAPI. Version the inputs,\ntrack runs and monitor corrections after release.",
      "originalText": "Serve one model with FastAPI. Version the inputs,\ntrack runs and monitor corrections after release.",
      "fontSize": 9.04,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
